> PROCEDURE alert(text$)
  GRAPHMODE 1
  ~VQT_EXTENT(text$,n,n,width,n,n,n,n,n)
  boxlen=width+8
  x1=320-boxlen/2
  GET x1-4,178,x1+boxlen+4,222,alert_buffer$
  DEFFILL 0
  PBOX x1-4,178,x1+boxlen+4,222
  BOX x1,182,x1+boxlen,218
  DEFLINE 1,2
  BOX x1-4,178,x1+boxlen+4,222
  tabulate=320-(width/2)
  TEXT tabulate,204,text$
  PAUSE 5
  REPEAT
    MOUSE x,y,k
    key=ASC(INKEY$)
  UNTIL ((k=1 OR k=2) AND (x>x1-4) AND (x<x1+boxlen+14) AND (y>178) AND (y<222)) OR key=13
  @button_flash(x1,182,x1+boxlen,218)
  REPEAT
  UNTIL MOUSEK=0
  @button_flash(x1,182,x1+boxlen,218)
  PUT x1-4,178,alert_buffer$
RETURN
