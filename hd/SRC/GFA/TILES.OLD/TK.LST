'
' ***** Magic Spells *****
'
> PROCEDURE spells
  IF potential=0
    IF skill_flag!=FALSE
      skill_potential=traits(3)
    ENDIF
    skill_flag!=TRUE
    exit_spell_menu!=FALSE
    get_character_sheet
    good_selection!=TRUE
    draw_spell_menu
    which_level_displayed=1
    spell_list(1)
    which_spell=1
    REPEAT
      spell_menu_select
    UNTIL exit_spell_menu!
    quit_skills
  ELSE
    alert("You haven't used all of your potential!")
  ENDIF
RETURN
> PROCEDURE spell_list(level)
  clear_output_window
  PRINT AT(3,2);skill_level$(level);" Magic Spells"
  FOR i=1 TO num_spells(level)
    PRINT AT(3,3+i);spell_name$(level,i)
  NEXT i
  PRINT AT(3,24);"POTENTIAL"
  PRINT AT(16,24);skill_potential
  IF skill_potential<>0
    GRAPHMODE 0
    DEFFILL 1
    PBOX 160,370,160+skill_potential,382
  ENDIF
RETURN
> PROCEDURE draw_spell_menu
  blank_menu_space
  write("Spell Menu",1,0,0)
  write("**********",1,0,0)
  blank_line
  write("Alter spells ",1,0,0)
  write("Return to character menu",1,0,0)
  blank_line
  blank_line
  blank_line
  blank_line
  blank_line
  reverse(374,(spell_menu_position+15)*16+1,578,(spell_menu_position+16)*16)
RETURN
> PROCEDURE spell_menu_select
  MOUSE x,y,k
  key$=INKEY$
  IF LEN(key$)
    key=ASC(RIGHT$(key$,1))
    SELECT key
    CASE 27
      exit_spell_menu!=TRUE
    CASE 72
      spell_menu_position=@scroll_cursorbar(17,18,48,25,0,spell_menu_position)
    CASE 80
      spell_menu_position=@scroll_cursorbar(17,18,48,25,1,spell_menu_position)
    CASE 13
      SELECT spell_menu_position
      CASE 1
        spell_select
      CASE 2
        exit_spell_menu!=TRUE
      ENDSELECT
    ENDSELECT
    '
  ELSE IF k
    button=@text_button(48,17,72,18,x,y,1)
    IF button
      SELECT button
      CASE 2
        exit_spell_menu!=TRUE
      ENDSELECT
    ELSE
      button=@text_button(3,4,14,num_spells(1)+3,x,y,0)
      IF button
        IF k=2
          learn_spell(button)
        ELSE IF k=1
          forget_spell(button)
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  '
RETURN
> PROCEDURE spell_select
  exit_spell_selection!=FALSE
  reverse(14,(which_spell-1)*16+49,114,(which_spell)*16+48)
  REPEAT
    key$=INKEY$
    IF LEN(key$)
      key=ASC(RIGHT$(key$,1))
      SELECT key
      CASE 27,13
        exit_spell_selection!=TRUE
      CASE 72
        which_spell=@scroll_cursorbar(4,3+num_spells(1),3,12,0,which_spell)
      CASE 80
        which_spell=@scroll_cursorbar(4,3+num_spells(1),3,12,1,which_spell)
      CASE 77
        learn_spell(which_spell)
      CASE 75
        forget_spell(which_spell)
      ENDSELECT
    ENDIF
  UNTIL exit_spell_selection!
  reverse(14,(which_spell-1)*16+49,114,(which_spell)*16+48)
RETURN
> PROCEDURE learn_spell(which_spell)
  IF spell_learned!(which_spell,1)=FALSE
    IF skill_potential=>5
      SUB skill_potential,5
      PRINT AT(16,24);skill_potential;" "
      DEFFILL 0
      GRAPHMODE 0
      PBOX 160+skill_potential,370,275,382
      spell_learned!(which_spell,1)=TRUE
      PRINT AT(17,which_spell+3);
      OUT 5,8
      INC num_spells_learned(1)
    ELSE
      alert("You don't have enough skill potential points!")
    ENDIF
  ENDIF
RETURN
> PROCEDURE forget_spell(which_spell)
  IF spell_learned!(which_spell,1)=TRUE
    ADD skill_potential,5
    PRINT AT(16,24);skill_potential;" "
    GRAPHMODE 0
    DEFFILL 1
    PBOX 160,370,160+skill_potential,382
    spell_learned!(6,1)=FALSE
    PRINT AT(17,which_spell+3);" "
    DEC num_spells_learned(1)
    spell_learned!(which_spell,1)=FALSE
  ENDIF
RETURN
