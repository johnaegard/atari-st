' Talon Keep Phase II
' Re-Started September 22/90
' By John Aegard
'
' inkey_demo
OPTION BASE 1
ON BREAK GOSUB endit
cursor_flag!=TRUE
cursor_setup
gdos_setup
mouse_setup
@data_setup
@load_roster
screen_setup
' coord
icon_setup
variable_setup
check_parties
party_load
world_load(world)
main_loop
'
' ***** Setup procedures *****
'
> PROCEDURE cursor_setup
  DIM cursor$(8)
  FOR i=0 TO 6
    CLS
    '   LINE 3,i,3,14-i
    '    LINE TRUNC(i/2),7,6-TRUNC(i/2),7
    BOX i,0,7-i,11
    GET 0,0,7,12,cursor$(i+1)
  NEXT i
  CLS
RETURN
> PROCEDURE gdos_setup
  face=1
  IF GDOS?
    ~VST_LOAD_FONTS(0)
    face=VQT_NAME(2,null$)
    DEFTEXT ,,,12,face
  ELSE
    DEFTEXT ,,,13,1
  ENDIF
RETURN
> PROCEDURE mouse_setup
  RESTORE mouse_data
  DIM mouse$(5)
  FOR l=1 TO 5
    IF l=1
      mouse$(l)=MKI$(0)+MKI$(0)+MKI$(1)
    ELSE
      mouse$(l)=MKI$(8)+MKI$(8)+MKI$(1)
    ENDIF
    mouse$(l)=mouse$(l)+MKI$(0)+MKI$(1)
    FOR i%=1 TO 16
      READ backgrnd
      mouse$(l)=mouse$(l)+MKI$(backgrnd)
    NEXT i%
    FOR i%=1 TO 16
      READ foregrnd
      LET mouse$(l)=mouse$(l)+MKI$(foregrnd)
    NEXT i%
  NEXT l
  DEFMOUSE mouse$(1)
RETURN
> PROCEDURE screen_setup
  CHDRIVE "a:\"
  SETCOLOR 0,0
  file$="d:\talon2.pi3"
  OPEN "i",#1,file$
  null$=INPUT$(34,#1)
  pic$=INPUT$(32000,#1)
  CLOSE #1
  SPUT pic$
  FOR i=0 TO 3
    LINE 312,30+(i*48),635,30+(i*48)
  NEXT i
  CLR pic$
RETURN
> PROCEDURE icon_setup
  RESTORE icon_data
  READ num_icons
  DIM icon$(num_icons)
  DIM passable!(num_icons)
  DIM terrain$(num_icons)
  FOR i=1 TO num_icons
    READ file$
    READ passable!(i)
    file$="d:\"+file$+".icn"
    IF NOT EXIST(file$)
      file$="A:\icons\"+file$+".icn"
    ENDIF
    OPEN "i",#1,file$
    length=LOF(#1)
    icon$(i)=INPUT$(length,#1)
    CLOSE #1
  NEXT i
  FOR i=1 TO num_icons
    READ terrain$(i)
  NEXT i
RETURN
> PROCEDURE data_setup
  DIM race$(4)
  RESTORE race_data
  FOR i=1 TO 4
    READ race$(i)
  NEXT i
  DIM racial_attributes(4,9)
  ARRAYFILL racial_attributes(),10
  FOR race1=1 TO 4
    FOR attribute=1 TO 4
      READ racial_attributes(race1,attribute)
    NEXT attribute
  NEXT race1
  DIM racial_ads$(4,3)
  FOR race1=1 TO 4
    FOR ad=1 TO 3
      READ racial_ads$(race1,ad)
    NEXT ad
  NEXT race1
  DIM skill_level$(6)
  FOR i=1 TO 6
    READ skill_level$(i)
  NEXT i
  READ num_skills
  READ num_combat_skills
  num_other_skills=num_skills-num_combat_skills
  DIM skill_name$(num_skills)
  DIM skill_title$(num_skills)
  DIM skill_points(num_skills)
  DIM skill_difficulty(num_skills)
  DIM skill_type!(num_skills)
  DIM skill_def_penalty(num_skills)
  ARRAYFILL skill_level(),1
  FOR i=1 TO num_skills
    READ skill_name$(i)
    READ skill_difficulty(i)
    READ skill_type!(i)
    READ skill_def_penalty(i)
    '    LPRINT skill_name$(i),skill_difficulty(i),skill_type!(i),skill_def_penalty(i)
  NEXT i
  '
  FOR i=1 TO num_skills
    READ skill_title$(i)
  NEXT i
  '
  READ num_spell_levels
  DIM num_spells(num_spell_levels)
  FOR level=1 TO num_spell_levels
    READ num_spells(level)
    IF num_spells(level)>max_num_spells
      max_num_spells=num_spells(level)
    ENDIF
  NEXT level
  DIM spell_name$(num_spell_levels,max_num_spells)
  '
  FOR level=1 TO num_spell_levels
    FOR spell=1 TO num_spells(level)
      READ spell_name$(level,spell)
    NEXT spell
  NEXT level
  '
  DIM num_items(4)
  FOR i=1 TO 4
    READ num_items(i)
  NEXT i
  max=MAX(num_items(1),num_items(2),num_items(3),num_items(4))
  DIM item$(4,max)
  DIM two_handed!(num_items(1))
  FOR i=1 TO 4
    FOR i1=1 TO num_items(i)
      READ item$(i,i1)
      IF i=1
        READ two_handed!(i1)
      ENDIF
    NEXT i1
  NEXT i
RETURN
> PROCEDURE variable_setup
  prompt$=">"
  DIM char_name$(4)
  DIM race|(4)
  DIM potential|(4)
  DIM status|(4)
  DIM hit_points|(4)
  DIM mana_points|(4)
  DIM fatigue|(4)
  DIM armour_points|(4)
  DIM silver|(4)
  DIM gold|(4)
  DIM traits|(4,7)
  DIM poison|(4)
  DIM disease|(4)
  DIM skill_level|(4,num_skills)
  DIM skill_value|(4,num_skills)
  DIM num_spells_learned|(4,num_spell_levels)
  DIM spell_learned!(4,20,6)
  DIM inventory|(4,22,13)             ! Player 4 Spot 22 Item 13  (2=item #)  (1=type#)
  DIM inventory$(4,22)                ! String descriptions of the items
  DIM title$(4)
  DIM weapon$(4)
  DIM injuries!(4,6)
RETURN
> PROCEDURE world_variable_setup
  DIM terrain|(x_width,y_width)
  DIM special!(x_width,y_width)
  DIM special$(40,30)
  DIM special_num|(200)
  DIM special_loc|(200,2)
  DIM num_lines|(200)
RETURN
> PROCEDURE world_load(w)
  file$="a:\maps\m"+STR$(w)
  OPEN "i",#1,file$
  INPUT #1,x_width
  INPUT #1,y_width
  INPUT #1,world_name$
  world_variable_setup
  FOR i=1 TO y_width
    FOR i1=1 TO x_width
      terrain|(i1,i)=ASC(INPUT$(1,#1))
      IF terrain|(i1,i)>100
        SUB terrain|(i1,i),100
        special!(i1,i)=TRUE
      ENDIF
    NEXT i1
  NEXT i
  CLOSE
  special_load
  draw_page
RETURN
> PROCEDURE special_load
  file$="A:\maps\e"+STR$(world)
  OPEN "i",#1,file$
  INPUT #1,num_encounter$
  num_encounters=ASC(num_encounter$)
  FOR i=1 TO num_encounters
    INPUT #1,special$(i,1)
    special_num|(i)=VAL(RIGHT$(special$(i,1),1))
    INPUT #1,s$
    special_loc|(i,1)=ASC(LEFT$(s$,1))
    special_loc|(i,2)=ASC(MID$(s$,2,1))
    num_lines|(i)=ASC(RIGHT$(s$,1))
    FOR i1=1 TO num_lines|(i)-1
      INPUT #1,special$(i,i1+1)
    NEXT i1
  NEXT i
RETURN
'
' ***** Party Loading Procedures *****
'
> PROCEDURE load_roster
  DIM roster$(20)
  DIM party_member(20)
  OPEN "i",#1,"a:\chars\roster"
  FOR i=1 TO 20
    INPUT #1,roster$(i)
    INPUT #1,party_member$
    IF ASC(party_member$)
      party_member(i)=ASC(party_member$)
      IF ASC(party_member$)>highest_party_so_far
        highest_party_so_far=ASC(party_member$)
      ENDIF
    ENDIF
  NEXT i
  CLOSE #1
RETURN
> PROCEDURE party_load
  message$="Select party to load ( "
  FOR i=1 TO 5
    IF party_occupied!(i)=TRUE
      message$=message$+STR$(i)+" "
    ENDIF
  NEXT i
  message$=message$+")"
  GRAPHMODE 1
  ~VQT_EXTENT(message$,n,n,width,n,n,n,n,n)
  boxlen=width+8
  x1=320-boxlen/2
  GET x1-4,178,x1+boxlen+4,222,alert_buffer$
  DEFFILL 0
  PBOX x1-4,178,x1+boxlen+4,222
  BOX x1,182,x1+boxlen,218
  DEFLINE 1,2
  BOX x1-4,178,x1+boxlen+4,222
  tabulate=320-width/2
  norm
  TEXT tabulate,204,message$
  PAUSE 5
  DO
    REPEAT
      key=ASC(INKEY$)
    UNTIL (49<=key AND key<=53)
    IF (49<=key AND key<=53)
      EXIT IF party_occupied!(key-48)=TRUE
    ENDIF
  LOOP
  @button_flash(x1,182,x1+boxlen,218)
  @button_flash(x1,182,x1+boxlen,218)
  PUT x1-4,178,alert_buffer$
  party_to_be_loaded=key-48
  find_characters
  @load_party_file(party_to_be_loaded)
RETURN
> PROCEDURE check_parties
  ERASE party_occupied!()
  DIM party_occupied!(5)
  ARRAYFILL party_occupied!(),FALSE
  FOR i=1 TO 20
    IF party_member(i)
      party_occupied!(party_member(i))=TRUE
    ENDIF
  NEXT i
RETURN
> PROCEDURE load_party_file(u)
  file$="a:\chars\p"+STR$(u)
  OPEN "i",#1,file$
  world=@get_a_char
  world=1
  xpos=@get_a_char
  ypos=@get_a_char
  food=@get_a_char
  day=@get_a_char
  year=@get_a_char
  CLOSE #1
RETURN
> PROCEDURE find_characters
  DIM party_members(4)
  FOR i=1 TO 20
    IF party_member(i)=party_to_be_loaded
      INC a
      party_members(a)=i
    ENDIF
  NEXT i
  FOR q=1 TO 4
    @load_character(q,party_members(q))
    figure_top_score(q)
  NEXT q
  set_inventory
  FOR q=1 TO 4
    compile_items(q)
    @display_character(q)
  NEXT q
RETURN
> PROCEDURE load_character(a,which_character)
  file$="a:\chars\"+"ch"+STR$(which_character)
  OPEN "i",#1,file$
  length_of_name=@get_a_char
  char_name$(a)=INPUT$(length_of_name,#1)
  race|(a)=@get_a_char
  potential|(a)=@get_a_char
  status|(a)=@get_a_char
  hit_points|(a)=@get_a_char
  hit_points|(1)=0
  mana_points|(a)=@get_a_char
  fatigue|(a)=@get_a_char
  silver|(a)=@get_a_char
  gold|(a)=@get_a_char
  FOR i=1 TO 7
    traits|(a,i)=@get_a_char
  NEXT i
  poison|(a)=@get_a_char
  disease|(a)=@get_a_char
  FOR i=1 TO num_skills
    skill_level|(a,i)=@get_a_char
  NEXT i
  FOR i=1 TO num_skills
    skill_value|(a,i)=@get_a_char
  NEXT i
  FOR i1=1 TO num_spell_levels
    num_spells_learned|(a,i1)=@get_a_char
    FOR i=1 TO num_spells_learned|(a,i1)
      spell_number=@get_a_char
      spell_learned!(a,spell_number,i1)=TRUE
    NEXT i
  NEXT i1
  FOR i=1 TO 22
    FOR i1=1 TO 13
      inventory|(a,i,i1)=@get_a_char
    NEXT i1
  NEXT i
  CLOSE #1
RETURN
> PROCEDURE display_character(a)
  IF hit_points|(a)=0
    light
  ELSE
    bold
  ENDIF
  TEXT 315,24+(a-1)*48,char_name$(a)
  norm
  TEXT 315,46+(a-1)*48,title$(a)
  bold
  TEXT 445,24+(a-1)*48,"H:"
  width=@width("H:")
  norm
  TEXT 445+width,24+(a-1)*48,STR$(hit_points|(a))
  bold
  TEXT 493,24+(a-1)*48,"M:"
  width=@width("M:")
  norm
  TEXT 493+width,24+(a-1)*48,STR$(mana_points|(a))
  bold
  TEXT 542,24+(a-1)*48,"F:"
  width=@width("F:")
  norm
  TEXT 542+width,24+(a-1)*48,STR$(fatigue|(a))
  IF inventory$(a,1)=""
    inventory$(a,1)="Weaponless"
  ENDIF
  width=@width(inventory$(a,1))
  norm
  TEXT 630-width,46+(a-1)*48,inventory$(a,1)
  IF inventory$(a,1)="Weaponless"
    inventory$(a,1)=""
  ENDIF
  bold
  TEXT 590,24+(a-1)*48,"A:"
  width=@width("A:")
  norm
  TEXT 590+width,24+(a-1)*48,armour_points|(a)
RETURN
> PROCEDURE figure_top_score(a)
  top_skill=1
  FOR i=1 TO num_skills
    xss=skill_level|(a,i)*100+skill_value|(a,i)
    IF xss>skill_level|(a,top_skill)*100+skill_value|(a,top_skill)
      IF skill_title$(top_skill)<>"null"
        top_skill=i
      ENDIF
    ENDIF
  NEXT i
  title$(a)=skill_level$(skill_level|(a,top_skill))+" "+race$(race|(a))+" "+skill_title$(top_skill)
RETURN
> PROCEDURE set_inventory
  RESTORE inventory_data
  FOR i=1 TO 22
    FOR i1=1 TO 4
      READ inventory|(1,i,i1)
    NEXT i1
  NEXT i
RETURN
'
' ***** Main Loop *****
'
> PROCEDURE main_loop
  prompt
  DO
    '
    ' *** Key handling
    '
    key$=INKEY$
    IF LEN(key$)
      key=ASC(RIGHT$(key$,1))
      SELECT key
      CASE 59 TO 62
        c_2_b=key-58
        show_character(c_2_b)
      CASE 32
        pass
      CASE 50
        south
      CASE 52
        west
      CASE 54
        east
      CASE 56
        north
      CASE 84,116,76,108
        talk_or_look
      ENDSELECT
    ENDIF
    '
    ' *** Mouse inspection
    '
    MOUSE x,y,k
    find_mouse(x,y,row,col)
    check_mouse(row,col)
    IF k=1
      IF x=>314 AND x<=635 AND y=>9 AND y<=195
        c_2_b=INT((y-4)/48)+1
        show_character(c_2_b)
      ELSE IF old_cursor<>1
        ON (old_cursor-1) GOSUB north,east,south,west
      ENDIF
    ELSE IF k=2
    ENDIF
  LOOP
RETURN
'
' ***** Subordinate (to the mainline) procedures *****
'
> PROCEDURE pass
  EVERY STOP
  write("Pass",FALSE,FALSE,FALSE)
  prompt
RETURN
> PROCEDURE north
  EVERY STOP
  write("North",FALSE,FALSE,FALSE)
  move_up
  '     check_text_counter
  check_for_special(xpos,ypos,"A")
  prompt
RETURN
> PROCEDURE south
  EVERY STOP
  write("South",FALSE,FALSE,FALSE)
  move_down
  '        check_text_counter
  check_for_special(xpos,ypos,"A")
  prompt
RETURN
> PROCEDURE west
  EVERY STOP
  write("West",FALSE,FALSE,FALSE)
  move_left
  '       check_text_counter
  check_for_special(xpos,ypos,"A")
  prompt
RETURN
> PROCEDURE east
  EVERY STOP
  write("East",FALSE,FALSE,FALSE)
  move_right
  '      check_text_counter
  check_for_special(xpos,ypos,"A")
  prompt
RETURN
> PROCEDURE show_character(a)
  EVERY STOP
  reverse(314,(a-1)*48+8,634,((a)*48+3))
  write("Examine character "+STR$(a),FALSE,FALSE,FALSE)
  write("Press a key or click to go on.",FALSE,FALSE,FALSE)
  reverse(314,(a-1)*48+8,634,((a)*48+3))
  clear_output_window
  first_page(a)
  skill_pages(a)
  spell_page(a)
  equipment_page(a)
  clear_output_window
  draw_page
  prompt
RETURN
> PROCEDURE talk_or_look
  EVERY STOP
  SELECT key
  CASE 84,116
    write("Talk",FALSE,FALSE,FALSE)
    stim$="T"
  CASE 76,108
    write("Look",FALSE,FALSE,FALSE)
    stim$="L"
  ENDSELECT
  get_a_direction(dir)
  EVERY STOP
  SELECT dir
  CASE 50
    write("South",FALSE,FALSE,FALSE)
    check_for_special(xpos,ypos+1,stim$)
    prompt
  CASE 52
    write("West",FALSE,FALSE,FALSE)
    check_for_special(xpos-1,ypos,stim$)
    prompt
  CASE 54
    write("East",FALSE,FALSE,FALSE)
    check_for_special(xpos+1,ypos,stim$)
    prompt
  CASE 56
    write("North",FALSE,FALSE,FALSE)
    check_for_special(xpos,ypos-1,stim$)
    prompt
  ENDSELECT
RETURN
'
' ***** Motion (apparent) procedures *****
'
> PROCEDURE move_right
  INC xpos
  IF passable!(terrain|(xpos,ypos))=TRUE
    move1$=@get_piece$(8,1,11,13)
    move2$=@get_piece$(2,1,5,13)
    move3$=@get_piece$(7,1,7,6)
    move4$=@get_piece$(7,8,7,13)
    move5$=@get_piece$(6,1,6,6)
    move6$=@get_piece$(6,8,6,13)
    put_piece(7,1,move1$)
    put_piece(1,1,move2$)
    put_piece(6,1,move3$)
    put_piece(6,8,move4$)
    put_piece(5,1,move5$)
    put_piece(5,8,move6$)
    put_piece(5,7,icon$(terrain|(xpos-1,ypos)))
    FOR i=1 TO 13
      put_piece(11,i,icon$(terrain|(xpos+5,i+ypos-7)))
    NEXT i
  ELSE
    DEC xpos
    write("BLOCKED",FALSE,FALSE,FALSE)
  ENDIF
  CLR move1$,move2$,move3$,move4$,move5$,move6$
RETURN
> PROCEDURE move_left
  DEC xpos
  IF passable!(terrain|(xpos,ypos))=TRUE
    move1$=@get_piece$(1,1,4,13)
    move2$=@get_piece$(5,1,5,6)
    move3$=@get_piece$(5,8,5,13)
    move4$=@get_piece$(6,1,6,6)
    move5$=@get_piece$(6,8,6,13)
    move6$=@get_piece$(7,1,10,13)
    put_piece(2,1,move1$)
    put_piece(6,1,move2$)
    put_piece(6,8,move3$)
    put_piece(7,1,move4$)
    put_piece(7,8,move5$)
    put_piece(8,1,move6$)
    put_piece(7,7,icon$(terrain|(xpos+1,ypos)))
    FOR i=1 TO 13
      put_piece(1,i,icon$(terrain|(xpos-5,ypos-7+i)))
    NEXT i
  ELSE
    INC xpos
    write("BLOCKED",FALSE,FALSE,FALSE)
  ENDIF
  CLR move1$,move2$,move3$,move4$,move5$,move6$
RETURN
> PROCEDURE move_down
  INC ypos
  IF passable!(terrain|(xpos,ypos))=TRUE
    move1$=@get_piece$(1,2,11,6)
    move2$=@get_piece$(1,7,5,7)
    move3$=@get_piece$(7,7,11,7)
    move4$=@get_piece$(1,8,5,8)
    move5$=@get_piece$(7,8,11,8)
    move6$=@get_piece$(1,9,11,13)
    put_piece(1,1,move1$)
    put_piece(1,6,move2$)
    put_piece(7,6,move3$)
    put_piece(1,7,move4$)
    put_piece(7,7,move5$)
    put_piece(1,8,move6$)
    put_piece(6,6,icon$(terrain|(xpos,ypos-1)))
    FOR i=1 TO 11
      put_piece(i,13,icon$(terrain|(xpos-6+i,ypos+6)))
    NEXT i
  ELSE
    DEC ypos
    write("BLOCKED",FALSE,FALSE,FALSE)
  ENDIF
  CLR move1$,move2$,move3$,move4$,move5$,move6$
RETURN
> PROCEDURE move_up
  DEC ypos
  IF passable!(terrain|(xpos,ypos))=TRUE
    move1$=@get_piece$(1,1,11,5)
    move2$=@get_piece$(1,6,5,6)
    move3$=@get_piece$(7,6,11,6)
    move4$=@get_piece$(1,7,5,7)
    move5$=@get_piece$(7,7,11,7)
    move6$=@get_piece$(1,8,11,12)
    put_piece(1,2,move1$)
    put_piece(1,7,move2$)
    put_piece(7,7,move3$)
    put_piece(1,8,move4$)
    put_piece(7,8,move5$)
    put_piece(1,9,move6$)
    put_piece(6,8,icon$(terrain|(xpos,ypos+1)))
    FOR i=1 TO 11
      put_piece(i,1,icon$(terrain|(xpos-6+i,ypos-6)))
    NEXT i
  ELSE
    INC ypos
    write("BLOCKED",FALSE,FALSE,FALSE)
  ENDIF
  CLR move1$,move2$,move3$,move4$,move5$,move6$
RETURN
> PROCEDURE draw_page
  DEFFILL 1,0
  PBOX 4,8,308,384
  FOR xi=xpos-5 TO xpos+5
    FOR yi=ypos-6 TO ypos+6
      PUT 8+(xi-xpos+5)*27,15+(yi-ypos+6)*28,icon$(terrain|(xi,yi))
    NEXT yi
  NEXT xi
  put_piece(6,7,icon$(8))
RETURN
> PROCEDURE put_piece(x,y,graphic$)
  PUT 8+(x-1)*27,15+(y-1)*28,graphic$
  CLR graphic$
RETURN
'
' ***** Character Inspection Routines *****
'
> PROCEDURE first_page(a)
  hit_points|(1)=0
  disease|(2)=2
  poison|(3)=5
  clear_output_window
  uline
  TEXT 14,26,char_name$(a)
  norm
  IF hit_points|(a)<=0
    TEXT 308-@width("Deceased")-20,26,"Deceased"
  ELSE IF disease|(a)<>0
    TEXT 308-@width("Diseased")-20,26,"Diseased"
  ELSE IF poison|(a)<>0
    TEXT 308-@width("Poisoned")-20,26,"Poisoned"
  ENDIF
  TEXT 14,45,title$(a)
  TEXT 14,76,"Strength"
  TEXT 14,94,"Dexterity"
  TEXT 14,112,"Intellect"
  TEXT 14,130,"Endurance"
  FOR i=1 TO 3
    TEXT 14,130+i*18,racial_ads$(race|(a),i)
  NEXT i
  BOUNDARY 1
  FOR i=1 TO 7
    TEXT 94,76+(i-1)*18,traits|(a,i)
    DEFFILL 1,2,4
    GRAPHMODE 0
    PBOX 128,66+(i-1)*18,128+traits|(a,i),76+(i-1)*18
  NEXT i
  TEXT 14,210,"Potential "
  TEXT 104,210,potential|(a)
  IF potential|(a)
    PBOX 128,200,128+potential|(a),208
  ENDIF
  TEXT 14,228,"Hit Points"
  IF hit_points|(a)
    PBOX 128,218,128+hit_points|(a),226
  ENDIF
  TEXT 104,228,hit_points|(a)
  TEXT 14,246,"Mana Points"
  TEXT 104,246,mana_points|(a)
  IF mana_points|(a)
    PBOX 128,236,128+mana_points|(a),244
  ENDIF
  TEXT 14,264,"Fatigue"
  TEXT 104,264,fatigue|(a)
  IF fatigue|(a)
    PBOX 128,254,128+fatigue|(a),262
  ENDIF
  wait
RETURN
> PROCEDURE skill_pages(a)
  clear_output_window
  uline
  TEXT 14,26,char_name$(a)+"  Combat Skills"
  norm
  FOR i=1 TO num_combat_skills
    TEXT 14,50+i*18,skill_name$(i)
    TEXT 128,50+i*18,LEFT$(skill_level$(skill_level|(a,i)))
    TEXT 140,50+i*18,skill_value|(a,i)
  NEXT i
  wait
  clear_output_window
  uline
  TEXT 14,26,char_name$(a)+"  Other Skills"
  q=0
  norm
  FOR i=num_combat_skills+1 TO num_skills
    INC q
    TEXT 14,50+q*18,skill_name$(i)
    TEXT 128,50+q*18,LEFT$(skill_level$(skill_level|(a,i)))
    TEXT 140,50+q*18,skill_value|(a,i)
  NEXT i
  wait
RETURN
> PROCEDURE spell_page(a)
  FOR i1=1 TO num_spell_levels
    spell_text_counter=0
    IF num_spells_learned|(a,i1)
      clear_output_window
      uline
      TEXT 14,26,char_name$(a)+"   "+skill_level$(i1)+" Spells"
      norm
      FOR i=1 TO num_spells(i)
        IF spell_learned!(a,i,i1)
          INC spell_text_counter
          TEXT 14,40+spell_text_counter*16,spell_name$(i1,i)
        ENDIF
      NEXT i
      wait
    ENDIF
  NEXT i1
RETURN
> PROCEDURE equipment_page(a)
  clear_output_window
  uline
  TEXT 14,26,char_name$(a)+"   Inventory"
  norm
  screen_counter=4
  uline
  TEXT 14,62,"Readied Items"
  norm
  FOR i=1 TO 8
    IF inventory$(a,i)<>""
      INC screen_counter
      TEXT 14,screen_counter*18,LEFT$(inventory$(a,i),17)
    ENDIF
  NEXT i
  ADD screen_counter,2
  uline
  TEXT 14,screen_counter*18,"Items in Belt"
  norm
  INC screen_counter
  FOR i=9 TO 12
    IF inventory$(a,i)<>""
      INC screen_counter
      TEXT 14,screen_counter*18-6,LEFT$(inventory$(a,i),17)
    ENDIF
  NEXT i
  screen_counter=4
  uline
  TEXT 164,62,"Items in Pack"
  norm
  FOR i=13 TO 22
    IF inventory$(a,i)<>""
      INC screen_counter
      TEXT 164,screen_counter*18,LEFT$(inventory$(a,i),17)
    ENDIF
  NEXT i
  ADD screen_counter,2
  TEXT 164,screen_counter*18,STR$(silver)+" Silver Nobles"
  TEXT 164,(screen_counter+1)*18,STR$(gold)+" Gold Crowns"
  wait
RETURN
> PROCEDURE compile_items(a)
  FOR i=1 TO 22
    IF inventory|(a,i,1)=0
      inventory$(a,i)=""
    ELSE
      inventory$(a,i)=item$(inventory|(a,i,1),inventory|(a,i,2))
      IF inventory|(a,i,3)<>0
        IF inventory|(a,i,1)=4 AND inventory|(a,i,2)=8
          inventory$(a,i)=inventory$(a,i)+" ("+STR$(inventory|(a,i,3))+")"
        ELSE
          inventory$(a,i)="*"+inventory$(a,i)
        ENDIF
      ENDIF
    ENDIF
  NEXT i
RETURN
'
' *****  Special Encounter Procedures  *****
'
> PROCEDURE check_for_special(sx,sy,stim$)
  is_special!=FALSE
  IF special!(sx,sy)
    FOR i=1 TO num_encounters
      IF special_loc|(i,1)=sx AND special_loc|(i,2)=sy AND stim$=special$(i,2)
        is_special!=TRUE
        special_interpreter(i)
      ENDIF
    NEXT i
  ENDIF
  IF NOT is_special!
    IF stim$="T"
      write("No one there!",FALSE,FALSE,FALSE)
    ELSE IF stim$="L"
      w$="You see "+terrain$(terrain|(sx,sy))+"."
      write(w$,FALSE,FALSE,FALSE)
    ENDIF
  ENDIF
RETURN
> PROCEDURE special_interpreter(q)
  EVERY STOP
  write("",0,0,0)
  special_counter=5
  exit_flag!=FALSE
  REPEAT
    IF special_counter>num_lines|(q)
      exit_flag!=TRUE
    ENDIF
    interpret_line(special_counter)
  UNTIL exit_flag!
  write("",0,0,0)
RETURN
> PROCEDURE interpret_line(VAR spc)
  command$=LEFT$(special$(q,spc),1)
  SELECT command$
  CASE "T"
    talk(q,spc)
    INC spc
  CASE "C"
    num_talks=VAL(RIGHT$(special$(q,spc),1))
    conversation(num_talks,last_line)
    spc=last_line
  CASE "V"
    v_talk(q,spc)
    INC spc
  CASE "G"
    g=VAL(RIGHT$(special$(q,spc),1))
    display_graphic(g)
    INC spc
  CASE "W"
    write("",0,0,0)
    write("(Press any key or click.)",0,0,0)
    wait
    INC spc
  CASE "R"
    draw_page
    INC spc
  ENDSELECT
RETURN
> PROCEDURE talk(q,line)
  IF promptflag!=TRUE
    promptflag!=FALSE
    DEC text_counter
  ENDIF
  l=LEN(special$(q,line))-2
  s$=RIGHT$(special$(q,line),l)
  write(s$,FALSE,FALSE,FALSE)
RETURN
> PROCEDURE v_talk(q,line)
  IF promptflag!=TRUE
    promptflag!=FALSE
    DEC text_counter
  ENDIF
  l=LEN(special$(q,line))-2
  s$=RIGHT$(special$(q,line),l)
  write(s$,TRUE,FALSE,FALSE)
RETURN
> PROCEDURE conversation(nt,VAR ll)
  prompt$="~"
  ll=special_counter
  FOR i=1 TO nt+1
    REPEAT
      INC ll
    UNTIL special$(q,ll)="END"
  NEXT i
  INC ll
  REPEAT
    inquiry$=@xinput$
    EXIT IF UPPER$(inquiry$)="BYE"
    p=special_counter+1
    num_ends=0
    z!=FALSE
    REPEAT
      IF UPPER$(inquiry$)=special$(q,p) AND special$(q,p)<>"END"
        z!=TRUE
        interpret_subclause(p)
      ELSE IF special$(q,p)="END"
        INC num_ends
      ELSE IF LEFT$(special$(q,p),1)="C"
        alert(RIGHT$(special$(q,p),1)+"has been added")
        ADD nt,VAL(RIGHT$(special$(q,p),1))
      ENDIF
      INC p
    UNTIL (z! OR num_ends=nt)
    IF num_ends=nt AND UPPER$(inquiry$)<>"BYE"
      interpret_subclause(p)
    ENDIF
  UNTIL UPPER$(inquiry$)="BYE"
  prompt$=">"
RETURN
> PROCEDURE interpret_subclause(VAR clause_line)
  DO
    EXIT IF special$(q,clause_line)="END"
    interpret_line(clause_line)
  LOOP
RETURN
> PROCEDURE display_graphic(g)
  CLOSE
  OPEN "i",#1,"A:\pics\"+STR$(g)+".PUT"
  pic$=INPUT$(LOF(#1),#1)
  PUT 4,8,pic$
  CLOSE
RETURN
