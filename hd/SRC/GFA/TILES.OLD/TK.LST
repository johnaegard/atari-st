' ******** Roster procedures *********
'
> PROCEDURE nuke_roster
  '  DO
  ' KILL "a:\chars\*.*"
  ' OOP
  OPEN "o",#1,"a:\chars\roster"
  FOR i=1 TO 20
    PRINT #1,""
    PRINT #1,CHR$(0)
  NEXT i
  CLOSE #1
RETURN
> PROCEDURE print_roster
  clear_output_window
  PRINT AT(3,2);"Character Roster"
  FOR i=1 TO 20
    IF roster$(i)<>""
      PRINT AT(3,3+i);roster$(i)
    ELSE
      PRINT AT(3,3+i);"< E M P T Y >"
    ENDIF
    IF party_member(i)>0
      PRINT AT(26,3+i);"*";party_member(i)
    ENDIF
  NEXT i
RETURN
> PROCEDURE save_roster
  OPEN "o",#1,"a:\chars\roster"
  FOR i=1 TO 20
    PRINT #1,roster$(i)
    IF party_member(i)>0
      PRINT #1,CHR$(party_member(i))
    ELSE
      PRINT #1,CHR$(0)
    ENDIF
  NEXT i
  CLOSE #1
RETURN
> PROCEDURE save_party_file(which_party)
  file$="a:\chars\p"+STR$(which_party)
  party$=CHR$(1)                        !  which world
  party$=party$+CHR$(20)+CHR$(20)       !  location
  party$=party$+CHR$(0)                 !  food
  party$=party$+CHR$(1)                 !  Day One
  party$=party$+CHR$(1)                 !  Year One
  party$=party$+CHR$(1)                 !  Morning
  party$=party$+STRING$(5000,0)         !  five thousand blank encounters!
  OPEN "o",#1,file$
  PRINT #1,party$
  CLOSE #1
RETURN
