> PROCEDURE coord
  DEFMOUSE 5
  REPEAT
    MOUSE x,y,k
    IF k
      PRINT AT(30,20);x
      PRINT AT(30,21);y
    ENDIF
  UNTIL k=2
RETURN
> PROCEDURE button_flash(x,y,x1,y1)
  reverse(x,y,x1,y1)
  REPEAT
  UNTIL MOUSEK=FALSE
  reverse(x,y,x1,y1)
RETURN
> PROCEDURE reverse(x2,y2,x3,y3)
  BOUNDARY FALSE
  GRAPHMODE 3
  DEFFILL 1,2,8
  PBOX x2,y2,x3,y3
  GRAPHMODE 1
RETURN
> PROCEDURE prompt
  cursor_status=1
  DEC text_counter
  write("",FALSE,TRUE,FALSE)
  EVERY 20 GOSUB cursor_flash
RETURN
> PROCEDURE write(write$,centred!,prompt!,inp_length)
  ' first split the write$ into 31-character strings
  ' with a space at each's end
  ' and then send them to the text_draw
  '
  EVERY STOP
  IF promptflag!=TRUE
    promptflag!=FALSE
    DEC text_counter
    write$=prompt$+write$
  ENDIF
  '
  IF LEN(write$)<=40
    text_draw(write$,centred!)
  ELSE
    l=LEN(write$)
    z=0
    DO
      DEC l
      INC z
      IF MID$(write$,l,1)=" " AND l<=40
        a1$=LEFT$(write$,LEN(write$)-z)
        text_draw(a1$,centred!)
        a2$=RIGHT$(write$,z)
        text_draw(a2$,centred!)
        EXIT IF z
      ENDIF
    LOOP
  ENDIF
  '
  IF prompt!
    promptflag!=TRUE
    text_draw(prompt$,0)
  ENDIF
  '
  IF inp_length
    promptflag!=FALSE
    PRINT AT(43,text_counter+13);
    FORM INPUT inp_length AS whatever$
  ENDIF
  '
RETURN
> PROCEDURE text_draw(text$,centred!)
  INC text_counter
  DEFTEXT 1,0,0,12,face
  '
  IF centred!
    ~VQT_EXTENT(text$,x1,null,x2,null,null,null,null,null)
    width=(x2-x1)/2
    x_pos=474-width
  ELSE
    x_pos=318
  ENDIF
  '
  IF text_counter<11
    TEXT x_pos,(text_counter+11)*18-2,text$
  ELSE
    DEC text_counter
    GET 318,220,635,384,text_save$
    PUT 318,202,text_save$
    offset=@width(text$)
    TEXT 318,376,SPACE$(52)
    TEXT x_pos,376,text$
  ENDIF
  '
RETURN
