' ***** Sub-Subordinate Procedures ******
'
> PROCEDURE find_mouse(x,y,VAR r,c)
  r=TRUNC((y-15)/27)+1
  c=TRUNC((x-8)/28)+1
RETURN
> PROCEDURE check_mouse(row,col)
  SELECT col
  CASE 5
    IF row=7 AND old_cursor<>5
      old_cursor=5
      DEFMOUSE mouse$(5)
    ENDIF
  CASE 6
    SELECT row
    CASE 6
      IF old_cursor<>2
        old_cursor=2
        DEFMOUSE mouse$(2)
      ENDIF
    CASE 8
      IF old_cursor<>4
        old_cursor=4
        DEFMOUSE mouse$(4)
      ENDIF
    DEFAULT
      IF old_cursor<>1
        old_cursor=1
        DEFMOUSE mouse$(1)
      ENDIF
    ENDSELECT
  CASE 7
    IF row=7 AND old_cursor<>3
      old_cursor=3
      DEFMOUSE mouse$(3)
    ENDIF
  DEFAULT
    IF old_cursor<>1
      old_cursor=1
      DEFMOUSE mouse$(1)
    ENDIF
  ENDSELECT
RETURN
