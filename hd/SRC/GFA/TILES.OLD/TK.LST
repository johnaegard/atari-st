DATA sea,0,fighter,0,wall,0,floor,1,pillar,0,door,0
DATA mage,0,sign,1,h_bridge,1,v_bridge,1
DATA a castle,forest,mountains,plains,a tower,a towne,water,a fighting man
DATA a wall,the floor,a pillar,a door,a magician,a sign,a bridge,a bridge
'
inventory_data:
DATA 1,10,0,0
DATA 4,2,1,0
DATA 3,15,1,0
DATA 0,0,0,0
DATA 0,0,0,0
DATA 0,0,0,0
DATA 2,8,0,0
DATA 2,6,0,0
DATA 1,1,0,0
DATA 1,1,0,0
DATA 4,8,20,0
DATA 0,0,0,0
DATA 4,3,0,0
DATA 4,5,0,0
DATA 0,0,0,0
DATA 0,0,0,0
DATA 0,0,0,0
DATA 0,0,0,0
DATA 0,0,0,0
DATA 0,0,0,0
DATA 0,0,0,0
DATA 0,0,0,0
'
' ***** Functions *****
'
FUNCTION xinput$
  prompt
  EVERY STOP
  cursor_status2=1
  w1=0
  EVERY 20 GOSUB cursor_flash2
  return$=""
  DO
    key=0
    key$=INKEY$
    IF LEN(key$)
      key=ASC(RIGHT$(key$,1))
      EXIT IF key=13
      IF key=8
        IF LEN(return$)=>1
          EVERY STOP
          PUT 326+w1,(text_counter+10)*18+5,cursor$(cursor_status2),0
          SUB w1,@width(RIGHT$(return$,1))
          DEFTEXT 0
          TEXT 326+w1,(text_counter+11)*18-2,RIGHT$(return$,1)
          DEFTEXT 1
          EVERY 20 GOSUB cursor_flash2
          return$=LEFT$(return$,LEN(return$)-1)
        ENDIF
      ELSE
        EVERY STOP
        TEXT 326+w1,(text_counter+11)*18-2,key$
        ADD w1,@width(key$)
        EVERY 20 GOSUB cursor_flash2
        return$=return$+key$
        cursor_status2=1
      ENDIF
    ENDIF
  LOOP UNTIL key=13
  EVERY STOP
  PUT 326+w1,(text_counter+10)*18+5,cursor$(cursor_status2),0
  INC text_counter
  RETURN return$
ENDFUNC
'
FUNCTION width(text$)
  ~VQT_EXTENT(text$,n,n,width,n,n,n,n,n)
  RETURN width
ENDFUNC
'
FUNCTION get_piece$(x1,y1,x2,y2)
  GET (8+(x1-1)*27),(15+(y1-1)*28),(7+(x2*27)),14+(y2)*28,return$
  RETURN return$
ENDFUNC
'
FUNCTION text_button(cursorx1,cursory1,cursorx2,cursory2,mx,my,not_allowed)
  IF mx=>(cursorx1-1)*8 AND mx<=(cursorx2*8)
    IF my=>(cursory1-1)*16 AND my<=(cursory2*16)
      text_button=INT((my-((cursory1-1)*16))/16)+1
      IF text_button<>not_allowed
        button_flash((cursorx1-1)*8-2,(text_button-2+cursory1)*16+1,(cursorx2*8)+2,(text_button+cursory1-1)*16)
        RETURN text_button
      ELSE
        RETURN 0
      ENDIF
    ELSE
      RETURN 0
    ENDIF
  ELSE
    RETURN 0
  ENDIF
ENDFUNC
'
FUNCTION scroll_cursorbar(top,bottom,left,width,down!,pos)
  IF down!=TRUE
    reverse((left-1)*8-2,(pos+top-2)*16+1,((left-1)*8)+width*8+2,(pos+top-1)*16)
    INC pos
    IF pos>bottom-top+1
      pos=1
    ENDIF
    reverse((left-1)*8-2,(pos+top-2)*16+1,((left-1)*8)+width*8+2,(pos+top-1)*16)
  ELSE
    reverse((left-1)*8-2,(pos+top-2)*16+1,((left-1)*8)+width*8+2,(pos+top-1)*16)
    DEC pos
    IF pos<1
      pos=bottom-top+1
    ENDIF
    reverse((left-1)*8-2,(pos+top-2)*16+1,((left-1)*8)+width*8+2,(pos+top-1)*16)
  ENDIF
  RETURN pos
ENDFUNC
FUNCTION convert_skill(skill_num,increment)
  ADD increment,1
  ADD skill_deci(skill_num),upordown
  IF skill_deci(skill_num)<>0 AND skill_deci(skill_num) MOD 2=0
    ADD increment,1
    skill_deci(skill_num)=0
  ENDIF
  RETURN increment
ENDFUNC
FUNCTION select_roster_spot
  reverse(14,(roster_spot-1)*16+49,194,(roster_spot)*16+48)
  DO
    MOUSE x,y,k
    key$=INKEY$
    IF LEN(key$)
      key=ASC(RIGHT$(key$,1))
      SELECT key
      CASE 27
        RETURN 0
      CASE 72
        roster_spot=@scroll_cursorbar(4,23,3,22,0,roster_spot)
      CASE 80
        roster_spot=@scroll_cursorbar(4,23,3,22,1,roster_spot)
      CASE 13
        RETURN roster_spot
      ENDSELECT
    ELSE IF k
      button=@text_button(3,4,22,23,x,y,0)
      IF button
        RETURN button
      ENDIF
    ENDIF
  LOOP
ENDFUNC
FUNCTION get_a_char
  return=ASC(INPUT$(1,#1))
  RETURN return
ENDFUNC
