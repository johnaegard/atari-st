PROCEDURE generalpreps
  orig_phys_screen%=XBIOS(2)
  orig_log_screen%=XBIOS(3)
  '
  freemem%=FRE(0)
  PRINT "free:",STR$(freemem%)
  '
  ' *** Create bufferscreen and get screen adresses ***
  '
  PRINT "allocating screen ram"
  '
  DIM screen1_ram_ary|(32255)
  screen1_ram%=V:screen1_ram_ary|(0)
  PRINT "screen1_ram:",STR$(screen1_ram%)
  '  VOID INP(2)
  '
  logicalscreen%=(screen1_ram%+255) AND &HFFFFFF00  ! Buffer screen address
  PRINT "logicalscreen page:",STR$(logicalscreen%/256)
  ' VOID INP(2)
  '
  physicalscreen%=orig_phys_screen%
  PRINT "physicalscreen page:",STR$(physicalscreen%/256)
  '
  DIM graphbuffer_ram_ary|(65000)
  graphbuffer%=V:graphbuffer_ram_ary|(0) ! Create memory buffer
  PRINT "graphbuffer:",STR$(graphbuffer%)
  ' VOID INP(2)
  '
  backing_store%=graphbuffer%
  PRINT "backing_store:",STR$(backing_store%)
  ' VOID INP(2)
  '
  sprite_store%=graphbuffer%+32000
  PRINT "sprite_store:",STR$(sprite_store%)
  ' VOID INP(2)
  '
  ' *** Save keyboard and interrupts ***
  '
  ' key|=BYTE{&H484}              ! save keyboard
  ' inter|=BYTE{&HFFFA09}         ! save interrupts
  ' BYTE{&H484}=AND(key|,&HFE)    ! keyboard sound off
  '  BYTE{&H484}=0              ! keyboard off
  ON ERROR GOSUB generalcleanup ! On error cleanup and quit
  ON BREAK GOSUB generalcleanup ! On break cleanup and quit
RETURN
PROCEDURE generalcleanup
  ' freemem%=FRE(0)
  ~XBIOS(5,L:orig_physical_screen%,L:orig_physical_screen%,-1) ! Default screens
  ' BYTE{&H484}=key|           ! restore keyboard
  ' BYTE{&HFFFA09}=inter|      ! restore interrupts
  ' {&H4D2}=0                  ! Stop any music that was playing
  ' WAVE 0,0                   ! Stop any sound that was playing
  ' ~GEMDOS(32,L:sup%)         ! Back to user mode
  ' OUT 4,8                    ! Enable mouse
RETURN
